# Copia este archivo como .env y ajusta los valores. El archivo .env NO se sube al repositorio.

# Cadena de conexion a PostgreSQL (obligatoria).
# Con docker-compose el host es "db"; si corres el backend fuera de Docker usa "localhost".
DATABASE_URL=postgresql+psycopg://rhcontrol:rhcontrol@db:5432/rhcontrol

# Clave para firmar los tokens JWT (obligatoria, minimo 16 caracteres).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Origenes permitidos por CORS, separados por coma (opcional).
CORS_ORIGINS=http://localhost:3000,http://localhost